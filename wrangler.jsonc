{
  // Cloudflare Workers configuration (task 0.5, ADR-0003). OpenNext turns `next build` output
  // into `.open-next/`; `pnpm preview` runs it locally, the deploy workflow ships it.
  // Bindings are not inherited by environments, so each one repeats `assets` and `services`.
  // Runtime secrets (SUPABASE_SECRET_KEY) travel with each deploy (`--secrets-file`), never
  // here. Public NEXT_PUBLIC_* values are inlined by `next build`, so they come from the build
  // environment (GitHub environment variables), not from `vars`. The one `vars` entry is
  // production's CANONICAL_HOST (below): routing, not configuration.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxoff-dev",
  // `worker/index.js` re-exports OpenNext's handler (`.open-next/worker.js`, from
  // `pnpm build:worker`) and adds the `scheduled` handler for the cron triggers (task 3.3).
  "main": "worker/index.js",
  // Cron triggers (ARCHITECTURE §11, WORKFLOWS §8 "worker" jobs): each expression is mapped
  // to its `/api/cron/<job>` route in `worker/index.js`; the route checks CRON_SECRET (a
  // Worker secret). Inheritable, and repeated in each environment on purpose so the schedule
  // is read where the environment is read. storage_cleanup: 03:00 IST = 21:30 UTC, daily.
  // push_dispatch (5.2): every minute; it also sends the 07:00 IST quiet-hours summary.
  "triggers": { "crons": ["30 21 * * *", "* * * * *"] },
  // 2025-08-16 or later: introduces `https.request`, which the Sentry SDK needs.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxoff-dev" }],
  // Workers Logs (free): request logs and console output in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "env": {
    // Staging: deployed from `main` by .github/workflows/deploy.yml. No real data. The account is on
    // Workers Paid (since 2026-09-23, confirmed by the owner 2026-09-30), which covers both Workers.
    // `preview_urls` is on so branch previews work (task 2.0): every version uploaded by
    // .github/workflows/preview.yml is reachable at <version>-maxoff-staging.<subdomain>
    // .workers.dev and at <branch>-maxoff-staging.<subdomain>.workers.dev. Stated here rather
    // than inherited from the account default (which follows `workers_dev`), so a dashboard
    // toggle cannot silently break previews.
    "staging": {
      "name": "maxoff-staging",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxoff-staging" }],
      "observability": { "enabled": true },
      "preview_urls": true,
      "triggers": { "crons": ["30 21 * * *", "* * * * *"] },
    },
    // X4 placement experiment (v2.0, the advisor on #89 6785051248; removed after the verdict): the
    // same code and the same staging Supabase as a `phase-v2` preview, on a Worker of its own, so
    // its placement is the only difference (placement is a per-Worker setting: turning it on for
    // `maxoff-staging` would move staging, the v1.9 baseline, too). Variant R first: pinned beside
    // the staging database (Mumbai, AWS ap-south-1); variant S (`"mode": "smart"`) only if R gains
    // or is inconclusive. Deployed only by `preview.yml`'s dispatch-only `placement-experiment`
    // job, never by deploy.yml. **No cron triggers** (`crons: []`: the top-level ones are
    // inherited otherwise, and they would send a second push and email run), no preview URLs; it
    // answers at maxoff-staging-smart.<subdomain>.workers.dev only.
    "staging-smart": {
      "name": "maxoff-staging-smart",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxoff-staging-smart" }],
      "observability": { "enabled": true },
      "preview_urls": false,
      "workers_dev": true,
      "triggers": { "crons": [] },
      "placement": { "mode": "targeted", "region": "aws:ap-south-1" },
    },
    // Production: deployed from a `v*` tag. Workers Paid (the account's plan, see staging).
    // `preview_urls` is off ON PURPOSE (task 2.0). Left at the account default, every
    // production version would also be served at <version>-maxoff.<subdomain>.workers.dev:
    // a public, unlisted address serving real data outside the custom domain and outside
    // anything put in front of it. Nothing in MaxOff needs that. Do not turn it on.
    //
    // The app lives at https://app.maxoff.in (3c.1, kickoff 3c decision 3a): `routes` connects
    // that hostname to this Worker as a Custom Domain (Cloudflare creates the DNS record and the
    // certificate in the maxoff.in zone; the deploy token needs the zone permissions README
    // names, or the owner attaches it once in the dashboard under Workers → maxoff → Domains &
    // Routes). The workers.dev address stays ON only so `worker/index.js` can send it to the
    // custom domain (308, path and query kept), keyed on `CANONICAL_HOST`: the one `vars`
    // entry in this file, production-only by construction. Never add the bare `maxoff.in`,
    // `www` or `mail.maxoff.in` here: the first two are reserved for a landing page, the
    // third belongs to Resend.
    "production": {
      "name": "maxoff",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxoff" }],
      "observability": { "enabled": true },
      "preview_urls": false,
      "workers_dev": true,
      "routes": [{ "pattern": "app.maxoff.in", "custom_domain": true }],
      "vars": { "CANONICAL_HOST": "app.maxoff.in" },
      "triggers": { "crons": ["30 21 * * *", "* * * * *"] },
    },
  },
}
