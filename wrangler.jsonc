{
  // Cloudflare Workers configuration (task 0.5, ADR-0003). OpenNext turns `next build` output
  // into `.open-next/`; `pnpm preview` runs it locally, the deploy workflow ships it.
  // Bindings are not inherited by environments, so each one repeats `assets` and `services`.
  // Runtime secrets (SUPABASE_SECRET_KEY) are set with `wrangler secret put --env <env>`, never
  // here. Public NEXT_PUBLIC_* values are inlined by `next build`, so they come from the build
  // environment (GitHub environment variables), not from `vars`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxoff-dev",
  // `worker/index.js` re-exports OpenNext's handler (`.open-next/worker.js`, from
  // `pnpm build:worker`) and adds the `scheduled` handler for the cron triggers (task 3.3).
  "main": "worker/index.js",
  // Cron triggers (ARCHITECTURE §11, WORKFLOWS §8 "worker" jobs): each expression is mapped
  // to its `/api/cron/<job>` route in `worker/index.js`; the route checks CRON_SECRET (a
  // Worker secret). Inheritable, and repeated in each environment on purpose so the schedule
  // is read where the environment is read. storage_cleanup: 03:00 IST = 21:30 UTC, daily.
  "triggers": { "crons": ["30 21 * * *"] },
  // 2025-08-16 or later: introduces `https.request`, which the Sentry SDK needs.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxoff-dev" }],
  // Workers Logs (free): request logs and console output in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "env": {
    // Staging: deployed from `main` by .github/workflows/deploy.yml. Free plan, no real data.
    // `preview_urls` is on so branch previews work (task 2.0): every version uploaded by
    // .github/workflows/preview.yml is reachable at <version>-maxoff-staging.<subdomain>
    // .workers.dev and at <branch>-maxoff-staging.<subdomain>.workers.dev. Stated here rather
    // than inherited from the account default (which follows `workers_dev`), so a dashboard
    // toggle cannot silently break previews.
    "staging": {
      "name": "maxoff-staging",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxoff-staging" }],
      "observability": { "enabled": true },
      "preview_urls": true,
      "triggers": { "crons": ["30 21 * * *"] },
    },
    // Production: deployed from a `v*` tag. Workers Paid from the pilot (task 6.6).
    // `preview_urls` is off ON PURPOSE (task 2.0). Left at the account default, every
    // production version would also be served at <version>-maxoff.<subdomain>.workers.dev:
    // a public, unlisted address serving real data outside the custom domain and outside
    // anything put in front of it. Nothing in MaxOff needs that. Do not turn it on.
    "production": {
      "name": "maxoff",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxoff" }],
      "observability": { "enabled": true },
      "preview_urls": false,
      "triggers": { "crons": ["30 21 * * *"] },
    },
  },
}
