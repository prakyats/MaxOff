# MaxOff environment variables.
#
# PRODUCTION IS LIVE (https://app.maxoff.in, in daily use since 2026-10-01). These values are
# for local development only: never put a production or staging value in `.env.local`, and
# never point a local run at the production database (CLAUDE.md -> "Production is live").
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is git-ignored
# and Claude Code is blocked from reading `.env*`, so real keys never reach the repo
# or the chat (CLAUDE.md, engineering rule 10).
#
# Every new environment variable is added here, with a comment, by the task that
# introduces it. Supabase (0.2), Sentry (0.5), sessions and email (1.2), Cloudflare R2,
# Web Push VAPID and Google Drive variables arrive in their own phases.

# Absolute URL the app is served from. Used for links in emails and dialogs (invite links since
# 1.3). Staging and production set it in their GitHub environment; locally it may be left out,
# and the request's own host is used instead (so any port works).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (task 0.2). Local values: run `pnpm db:start`, then `pnpm db:status` prints them.
# Staging and production values come from each project's dashboard (API keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" from db:status. The legacy anon JWT works too. Safe in the browser: RLS still applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" from db:status (legacy service_role JWT works too). Server only: it BYPASSES RLS.
# Used by jobs, cron routes and the Owner bootstrap script. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Which deployment this build is (task 0.5): local | staging | production. Tags Sentry events
# and is inlined at build time, so staging and production set it in their GitHub environment.
NEXT_PUBLIC_APP_ENV=local

# Sentry (task 0.5). Leave the DSN empty to turn Sentry off (local and CI). The DSN is not
# secret (it can only send events), so it is a GitHub environment *variable*, from
# Sentry → Settings → Projects → maxoff → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at deploy time only. Org and project slugs are variables (Sentry →
# Settings → General Settings); the auth token is a secret (Sentry → Settings → Auth Tokens,
# scopes: project:releases, org:read). Unset locally: no upload happens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sessions (task 1.2). Salts the client IP before it is stored as `session_events.ip_hash`.
# Any long random string (e.g. `openssl rand -hex 32`); a different one per environment. When
# unset, the hash is stored as null (never an unsalted hash). Staging/production: a GitHub
# environment secret, uploaded as a Worker secret by the deploy workflow.
SESSION_IP_HASH_SALT=

# Email (task 1.2 seam; first used by 1.3 invites, then 5.2 notification email). Resend →
# API Keys. Unset = nothing is sent and the app logs a warning at start-up (never a crash);
# in development each intended email is logged instead. Needs a verified sending domain
# (mail.maxoff.in, verified on Resend) before it is useful. Supabase Auth's own emails
# (password links) do not use it: they are configured in the Supabase dashboard.
RESEND_API_KEY=
# The From header for app email: `MaxOff <notifications@mail.maxoff.in>` on staging and production.
EMAIL_FROM=

# Web Push (task 5.2, ADR-0009). One VAPID key pair per environment, generated by the owner on
# their own laptop (never by a session, never committed). Unset = no push is sent; the in-app
# notifications still work. Read at runtime (not NEXT_PUBLIC): the server hands the public key to
# the browser. Staging/production: VAPID_PUBLIC_KEY and VAPID_SUBJECT are GitHub environment
# variables, VAPID_PRIVATE_KEY a secret; the deploy workflow uploads all three as Worker secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The push services' contact: a `mailto:` of the owner's own address.
VAPID_SUBJECT=
# Test only: `1` lets the sender POST to plain http on the loopback host (the e2e fake push
# service; playwright.config.ts sets it for its own server). Leave it unset everywhere else; it is
# ignored when NEXT_PUBLIC_APP_ENV is staging or production (5A review M2).
PUSH_ALLOW_LOOPBACK_ENDPOINTS=

# File storage (task 3.3, ARCHITECTURE §11): an S3-compatible bucket through one adapter.
# Local development and every e2e run use MinIO in Docker (`pnpm storage:start`, README →
# "Storage"); staging and production use Cloudflare R2 with the SAME variable names, set as
# Worker secrets / vars by the deploy workflow from the GitHub environment values
# R2_ACCOUNT_ID, R2_BUCKET, R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY:
#   S3_ENDPOINT          = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_BUCKET            = <R2_BUCKET>
#   S3_ACCESS_KEY_ID     = <R2_ACCESS_KEY_ID>
#   S3_SECRET_ACCESS_KEY = <R2_SECRET_ACCESS_KEY>
#   S3_REGION            = auto
# The local values below match docker-compose.storage.yml; they are throwaways.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=maxoff
S3_ACCESS_KEY_ID=maxoff
S3_SECRET_ACCESS_KEY=maxoff-local-secret
S3_REGION=auto
# The endpoint the BROWSER uploads to when it differs from S3_ENDPOINT (a Docker hostname the
# server sees but the phone does not). Unset = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# Not an app variable: CANONICAL_HOST is a Worker `vars` entry of the production environment in
# wrangler.jsonc (3c.1). `worker/index.js` sends a request on the workers.dev address to that host
# (308). Staging, previews and local runs have no such value and are served as they are.

# Cron routes (task 3.3, WORKFLOWS §8 "worker" jobs): the Worker's cron trigger calls
# /api/cron/<job> with `Authorization: Bearer <CRON_SECRET>`. Any long random string
# (`openssl rand -hex 32`), different per environment. Unset = every cron route answers 401
# (the job never runs), and a deployed build reports that to Sentry once. Staging/production:
# a GitHub environment secret, uploaded as a Worker secret on deploy.
CRON_SECRET=
