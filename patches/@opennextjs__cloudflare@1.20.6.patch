diff --git a/dist/cli/build/utils/copy-server-source-maps.js b/dist/cli/build/utils/copy-server-source-maps.js
new file mode 100644
index 0000000000000000000000000000000000000000..2ec6be9382edd3214f61e3e57b3cb5be432004e3
--- /dev/null
+++ b/dist/cli/build/utils/copy-server-source-maps.js
@@ -0,0 +1,20 @@
+// MaxOff patch (ARCHITECTURE §18.2): readable Sentry stack traces on the Worker.
+import { copyFileSync, existsSync, readdirSync } from "node:fs";
+import path from "node:path";
+/**
+ * OpenNext copies Next's traced server files but not their source maps. Copying each `.js.map`
+ * next to its copied `.js` lets esbuild chain the map of every chunk into the bundle's own map,
+ * so the Worker's map leads back to the app's source files.
+ *
+ * @param {string} fromServerDir Next's own `.next/server`
+ * @param {string} toServerDir the copy OpenNext bundles from
+ */
+export function copyServerSourceMaps(fromServerDir, toServerDir) {
+    if (!existsSync(toServerDir)) return;
+    for (const entry of readdirSync(toServerDir, { withFileTypes: true, recursive: true })) {
+        if (!entry.isFile() || !entry.name.endsWith(".js")) continue;
+        const target = path.join(entry.parentPath, `${entry.name}.map`);
+        const source = path.join(fromServerDir, path.relative(toServerDir, target));
+        if (existsSync(source) && !existsSync(target)) copyFileSync(source, target);
+    }
+}
