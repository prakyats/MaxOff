{
  "name": "maxoff",
  "version": "0.1.0",
  "private": true,
  "description": "Internal operations and control system for Pixora Clips",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "budget": "node scripts/bundle-budget.mjs",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && wrangler deploy --env production",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local --schema public > src/core/db/database.types.ts && prettier --write src/core/db/database.types.ts",
    "db:test": "supabase test db",
    "bootstrap:owner": "node --env-file=.env.local scripts/bootstrap-owner.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run db:test && pnpm run build && pnpm run budget",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
