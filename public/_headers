# Static asset headers served by the Worker's assets binding (OpenNext).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
# The manifest drives an INSTALLED app's name, icons and status-bar band. It must revalidate on
# every request: an hour of max-age meant a manifest change could not reach an existing install
# at all, and looked like the change had failed (task 1.5, four rounds of debugging).
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
# Icons have stable names (icon-192.png, not a content hash), so they are NOT immutable and must
# revalidate too. This matches what OpenNext already serves by default; it is written down so a
# default change cannot silently make a changed icon unreachable. sw.js revalidates them too.
/icons/*
  Cache-Control: public, max-age=0, must-revalidate
